def calculate_trend_and_significance(data):
	time = data["time"].astype(float)
	time_mean = time.mean(dim="time")
	data_mean = data.mean(dim="time")

	# Covariância entre tempo e a variável
	cov_time_data = ((time - time_mean) * (data - data_mean)).sum(dim="time")

	# Variância do tempo
	var_time = ((time - time_mean) ** 2).sum(dim="time")

	# Coeficiente de regressão (tendência)
	beta = cov_time_data / var_time

	# Intercepto
	alpha = data_mean - beta * time_mean

	# Valores previstos pela regressão
	y_pred = alpha + beta * time

	# Resíduos da regressão
	residuals = data - y_pred

	# Graus de liberdade
	n = data.sizes["time"]
	dof = n - 2

	# Soma dos quadrados dos resíduos
	rss = (residuals ** 2).sum(dim="time")

	# Variância residual
	residual_variance = rss / dof

	# Erro padrão do coeficiente beta
	std_error_beta = np.sqrt(residual_variance / var_time)

	# Estatística t para beta
	t_stat_beta = beta / std_error_beta

	# p-value para cada ponto espacial
	p_value = xr.apply_ufunc(
		t.cdf,
		np.abs(t_stat_beta),
		input_core_dims=[[]],
		kwargs={"df": dof},
		dask="parallelized",
		output_dtypes=[float]
	)
	p_value = 2 * (1 - p_value)  # Two-tailed test

	return beta, p_value

